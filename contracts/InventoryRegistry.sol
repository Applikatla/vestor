pragma solidity ^0.8.20;

import "./interfaces/IInventoryRegistry.sol";

/**
 * @title InventoryRegistry
 * @notice On-chain immutable anchoring point for real-world physical inventory.
 * @dev Corresponds to:
 *      - "Generate inventory ID and canonical record hash"
 *      - "InventoryRegistry stores immutable registration commitment"
 *      - "Inventory inspection and valuation"
 *      - "Inventory approved?" check
 */
contract InventoryRegistry is IInventoryRegistry {
    // Custom Errors
    error Unauthorized();
    error InventoryAlreadyExists(bytes32 inventoryId);
    error InventoryNotFound(bytes32 inventoryId);
    error InvalidStatusTransition(InspectionStatus currentStatus, InspectionStatus newStatus);
    error InvalidValuation();
    error NotFinancedVault();

    address public owner;
    mapping(address => bool) public authorizedInspectors;
    mapping(address => bool) public authorizedOperators;

    // Inventory storage: inventoryId => InventoryRecord
    mapping(bytes32 => InventoryRecord) private _inventories;

    modifier onlyOwner() {
        if (msg.sender != owner) revert Unauthorized();
        _;
    }

    modifier onlyOperatorOrOwner() {
        if (msg.sender != owner && !authorizedOperators[msg.sender]) revert Unauthorized();
        _;
    }

    modifier onlyInspectorOrOwner() {
        if (msg.sender != owner && !authorizedInspectors[msg.sender]) revert Unauthorized();
        _;
    }

    constructor() {
        owner = msg.sender;
        authorizedOperators[msg.sender] = true;
        authorizedInspectors[msg.sender] = true;
    }

    function setOperator(address operator, bool authorized) external onlyOwner {
        authorizedOperators[operator] = authorized;
    }

    function setInspector(address inspector, bool authorized) external onlyOwner {
        authorizedInspectors[inspector] = authorized;
    }

    function transferOwnership(address newOwner) external onlyOwner {
        if (newOwner == address(0)) revert Unauthorized();
        owner = newOwner;
    }

    /**
     * @notice Stores the immutable canonical record hash linking to off-chain PostgreSQL / WMS data.
     * @param inventoryId Unique UUID or hash generated by backend for the inventory batch.
     * @param canonicalRecordHash Keccak256 hash of (SKUs, quantities, warehouse ID, timestamps, inspection docs).
     * @param issuer The address of the borrower / verified company.
     */
    function registerInventory(
        bytes32 inventoryId,
        bytes32 canonicalRecordHash,
        address issuer
    ) external override onlyOperatorOrOwner {
        if (_inventories[inventoryId].status != InspectionStatus.Uninitialized) {
            revert InventoryAlreadyExists(inventoryId);
        }

        _inventories[inventoryId] = InventoryRecord({
            inventoryId: inventoryId,
            issuer: issuer,
            canonicalRecordHash: canonicalRecordHash,
            submittedAt: block.timestamp,
            valuation: 0,
            status: InspectionStatus.PendingInspection,
            inspectionEvidenceUri: "",
            financingVault: address(0)
        });

        emit InventoryRegistered(inventoryId, issuer, canonicalRecordHash, block.timestamp);
    }

    /**
     * @notice Updates the inspection and valuation result.
     * @param inventoryId Inventory ID being inspected.
     * @param valuation Appraised total value in stablecoin equivalent base units.
     * @param status Must be either Approved or Rejected.
     * @param evidenceUri URI (IPFS/Arweave/Document hash) containing inspector sign-offs.
     */
    function updateValuationAndInspection(
        bytes32 inventoryId,
        uint256 valuation,
        InspectionStatus status,
        string calldata evidenceUri
    ) external override onlyInspectorOrOwner {
        InventoryRecord storage item = _inventories[inventoryId];
        if (item.status == InspectionStatus.Uninitialized) {
            revert InventoryNotFound(inventoryId);
        }
        if (item.status == InspectionStatus.Financed || item.status == InspectionStatus.Closed) {
            revert InvalidStatusTransition(item.status, status);
        }
        if (status == InspectionStatus.Approved && valuation == 0) {
            revert InvalidValuation();
        }

        item.valuation = valuation;
        item.status = status;
        item.inspectionEvidenceUri = evidenceUri;

        emit InventoryInspectionUpdated(inventoryId, valuation, status, evidenceUri, msg.sender);
    }

    /**
     * @notice Locks inventory state when a financing issuance is initialized and vault is bound.
     */
    function markFinanced(bytes32 inventoryId, address vault) external override {
        InventoryRecord storage item = _inventories[inventoryId];
        if (item.status != InspectionStatus.Approved) {
            revert InvalidStatusTransition(item.status, InspectionStatus.Financed);
        }
        if (msg.sender != owner && !authorizedOperators[msg.sender] && msg.sender != vault) {
            revert Unauthorized();
        }

        item.status = InspectionStatus.Financed;
        item.financingVault = vault;

        emit InventoryFinanced(inventoryId, vault);
    }

    /**
     * @notice Closes the inventory record once financing is completely settled.
     */
    function closeInventory(bytes32 inventoryId, string calldata settlementReportUri) external override {
        InventoryRecord storage item = _inventories[inventoryId];
        if (item.status != InspectionStatus.Financed) {
            revert InvalidStatusTransition(item.status, InspectionStatus.Closed);
        }
        if (msg.sender != item.financingVault && msg.sender != owner) {
            revert NotFinancedVault();
        }

        item.status = InspectionStatus.Closed;
        emit InventoryClosed(inventoryId, settlementReportUri);
    }

    function getInventory(bytes32 inventoryId) external view override returns (InventoryRecord memory) {
        return _inventories[inventoryId];
    }

    function isInventoryApproved(bytes32 inventoryId) external view override returns (bool) {
        return _inventories[inventoryId].status == InspectionStatus.Approved;
    }
}


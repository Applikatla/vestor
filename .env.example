# ==============================================================================
# VESTOR — Institutional Real World Asset (RWA) Tokenization & Settlement Platform
# Environment Configuration Template (.env.example)
# Copy this file to .env before running services: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Private Keys & Relayer Signer
# ------------------------------------------------------------------------------
# Deployer & Admin wallet private key (used for Hardhat deployment, role provisioning)
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here

# Signer / Relayer wallet private key for blockchain adapter tx submission
SIGNER_PRIVATE_KEY=your_signer_private_key_here

# Backwards compatibility key
PRIVATE_KEY=your_private_key_here

# ------------------------------------------------------------------------------
# 2. Blockchain Networks & RPC Endpoints
# ------------------------------------------------------------------------------
# Active network: whitechainSepolia | sepolia | localhost
ACTIVE_NETWORK=whitechainSepolia

# Whitechain Sepolia (Chain ID: 1874 / 0x752)
WHITECHAIN_SEPOLIA_RPC_URL=https://rpc.testnet.whitechain.io
WHITECHAIN_TESTNET_RPC=https://rpc.ankr.com/whitechain_testnet
WHITECHAIN_TESTNET_BACKUP_RPC=https://rpc.testnet.whitechain.io

# Ethereum Sepolia (Chain ID: 11155111)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Number of block confirmations required by adapter
CONFIRMATIONS=1

# ------------------------------------------------------------------------------
# 3. Service Ports & Internal URLs
# ------------------------------------------------------------------------------
# Go Domain Core Backend
PORT=8080

# Blockchain Adapter Service
ADAPTER_PORT=8081
ADAPTER_URL=http://localhost:8081

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 4. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/tokenization_inventory?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=tokenization_inventory
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 5. MinIO / S3 Object Storage Configuration
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_ENDPOINT=localhost:9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# 6. Block Explorer API Keys
# ------------------------------------------------------------------------------
WHITECHAIN_EXPLORER_API_KEY=dummy
ETHERSCAN_API_KEY=

# ------------------------------------------------------------------------------
# 7. Live Verified Smart Contract Addresses (Whitechain Sepolia - Chain ID 1874)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=1874
NEXT_PUBLIC_ACCESS_CONTROLLER=0xD22E553477bb586c19Eb50E5b215bCE66A65111B
NEXT_PUBLIC_REGISTRY_ADDRESS=0xE85562e518a84c63330Ca7f7E67EC29Aa4ade09D
NEXT_PUBLIC_FACTORY_ADDRESS=0xEBC9D0006b1f35cB6BAFe18624A03f7fad6980Dc
NEXT_PUBLIC_SALES_SETTLEMENT=0x01ED64dCD39E76fb5e947f65165D9cA3454F483E
NEXT_PUBLIC_DISTRIBUTION_MANAGER=0xfd3Cb1A31f54b6DDCCa778fE6E15C346EF5d38F3
NEXT_PUBLIC_USDT_ADDRESS=0xcedfB56113143d55b2358b8CFbB0dEB5Ad2f55a7
NEXT_PUBLIC_MOCK_USDC_ADDRESS=0x100F1843Bf91962349cE9C84F45ae6581Eb72B61

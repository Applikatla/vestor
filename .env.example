# ==============================================================================
# Environment Configuration Template
# Copy this file to .env or subproject .env files before running services
# ==============================================================================

# Private Key for Deployment & Adapter Relayer (Do not commit real private keys!)
DEPLOYER_PRIVATE_KEY=your_private_key_here_without_quotes
SIGNER_PRIVATE_KEY=your_private_key_here_without_quotes

# RPC URLs
WHITECHAIN_SEPOLIA_RPC_URL=https://rpc.testnet.whitechain.io
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Active Network: whitechainSepolia | sepolia | localhost
ACTIVE_NETWORK=whitechainSepolia

# Service Ports
PORT=8080
ADAPTER_PORT=8081

# PostgreSQL Database URL
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/tokenization_inventory?sslmode=disable
